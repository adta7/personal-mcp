# Copy to .env.local for development:  cp .env.example .env.local
# In production these live in Vercel:  vercel env add <NAME>
# NEVER put real values in this file — it is committed to a PUBLIC repo.

# Canonical origin. Drives MCP resource URIs, JSON-LD, OpenAPI servers[], canonical tags.
# Local dev: http://localhost:3000
SITE_URL="https://albertyan.dev"

# --- Phase 7: authenticated admin writes ---
# High-entropy bearer token granting the admin scopes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_TOKEN=""

# Fine-grained GitHub PAT, Contents: read/write, scoped to THIS repo only.
# Used to commit authored content changes back to content/.
GITHUB_TOKEN=""
GITHUB_REPO="adta7/personal-mcp"
GITHUB_BRANCH="main"

# --- Phase 7: inbound message store (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Phase 7: notification on inbound message (Resend) ---
RESEND_API_KEY=""
NOTIFY_EMAIL=""
